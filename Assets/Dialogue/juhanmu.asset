  sceneName: "\uC218\uD55C\uBB34"
  references:
    version: 2
    RefIds:
    - rid: 1633149309827678283
      type: {class: Dialogue, ns: , asm: Assembly-CSharp}
      data:
        delayBefore: 1
        checkInput: 1
        textTargetPath: Shinuchi
        direction: 1
        Text: "\uC5B4\uB290 \uB0A0 \uADC0\uD55C <cramble>\uC9D1\uC548\uC758 \uC11C\uB300\uAC10\uC740
          5\uB300 \uB3C5\uC790\uC758 \uC7A5\uC218\uB97C \uAE30\uC6D0\uD558\uB294
          \uC774\uB984\uC744 \uC9C0\uC73C\uB824\uACE0 \uC720\uBA85\uD55C \uC810\uC7C1\uC774\uB97C
          \uCC3E\uC544\uAC14\uC2B5\uB2C8\uB2E4."
    - rid: 1633149309827678284
      type: {class: Dialogue, ns: , asm: Assembly-CSharp}
      data:
        delayBefore: 1
        checkInput: 1
        textTargetPath: Shinuchi
        direction: 2
        Text: "\uC810\uC7C1\uC774\uB294 \uC774\uB984\uC744 \uC9C0\uC5B4\uC8FC\uBA74\uC11C
          \uBE60\uB728\uB9AC\uBA74 \uC8FD\uB294\uB2E4\uB77C\uACE0 \uB9D0\uD588\uC2B5\uB2C8\uB2E4.
          \uC11C\uB300\uAC10\uC740 \uC774 \uACBD\uACE0\uB97C \uC544\uB4E4\uC758 \uC774\uB984\uC744
          \uB9D0\uD560 \uB54C \uD55C \uAE00\uC790\uB77C\uB3C4 \uBE60\uB728\uB9AC\uBA74
          \uC8FD\uB294\uB2E4\uB294 \uC758\uBBF8\uB85C \uD574\uC11D\uD558\uACE0 \uC11C\uC218\uD55C\uBB34\uB97C
          \uBD80\uB97C \uB54C \uC911\uAC04\uC5D0 \uD55C \uAE00\uC790\uB3C4 \uBE7C\uC9C0
          \uC54A\uACE0 \uD480\uB124\uC784\uC73C\uB85C \uC544\uB4E4\uC744 \uBD88\uB800\uC2B5\uB2C8\uB2E4."
    - rid: 1633149309827678285
      type: {class: Dialogue, ns: , asm: Assembly-CSharp}
      data:
        delayBefore: 1
        checkInput: 1
        textTargetPath: Shinuchi
        direction: 0
        Text: "\uC5B4\uB290 \uB0A0 \uC11C\uC218\uD55C\uBB34\uAC00 \uC6B0\uBB3C\uC5D0
          \uBE60\uC9C0\uC790 \uAE30\uAC81\uD55C \uCE5C\uAD6C\uB4E4\uC774 \uD558\uC778\uC5D0\uAC8C
          \uCC3E\uC544\uAC00 \uB9D0\uD588\uC2B5\uB2C8\uB2E4."
    - rid: 7292419771869167688
      type: {class: ChoiceDialogue, ns: , asm: Assembly-CSharp}
      data:
        delayBefore: 0
        textTargetPath: Shinuchi
        direction: 2
        next1:
          textName: "\uC774\uB984\uC744 \uB418\uBB3B\uAE30"
          appendDialPath: joohanmoo/1
        next2:
          textName: "\uAE40\uC218\uD55C\uBB34\uB85C \uC774\uB984\uC744 \uB418\uBB3B\uAE30"
          appendDialPath: joohanmoo/2
        next3:
