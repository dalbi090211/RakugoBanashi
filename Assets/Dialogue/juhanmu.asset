          appendDialPath: joohanmoo/3
    - rid: 7292419771869167693
      type: {class: Dialogue, ns: , asm: Assembly-CSharp}
      data:
        delayBefore: 0
        checkInput: 1
        textTargetPath: Shinuchi
        direction: 0
        Text: "\uADF8 \uC774\uB984\uC740 \"\uC218\uD55C\uBB34 <upwn>\uAC70\uBD81\uC774\uC640</upwn>
          \uB450\uB8E8\uBBF8 \uC0BC\uCC9C\uAC00\uBC14\uC790 \uB3D9\uBC29\uC0AD \uCE58\uCE58\uCE74\uD3EC
          \uC0AC\uB9AC\uC0AC\uB9AC\uC13C\uD0C0 \uC6CC\uB9AC\uC6CC\uB9AC \uC138\uBE0C\uB9AC\uAE61
          \uBB34\uB450\uC140\uB77C \uAD6C\uB984\uC774 \uD5C8\uB9AC\uCF00\uC778 \uB2F4\uBCBC\uB77D
          \uC11C\uC0DD\uC6D0 \uACE0\uC591\uC774 \uBC14\uB451\uC774 \uB3CC\uB3CC\uC774\"
          \uB77C\uB294 \uC774\uB984\uC774\uC600\uC2B5\uB2C8\uB2E4."
    - rid: 7292419771869167694
      type: {class: Dialogue, ns: , asm: Assembly-CSharp}
      data:
        delayBefore: 0
        checkInput: 1
        textTargetPath: Shinuchi
        direction: 2
        Text: "\uADF8 \uC810\uC7C1\uC774\uB294 \uC7A5\uC218\uB97C <shake>\uAE30\uC6D0\uD558\uB294</shake>
          \uC774\uB984\uC744 \uC9C0\uC73C\uB824\uACE0 \uC628\uAC16 \uC88B\uC740 \uC758\uBBF8\uC758
          \uC774\uB984\uC774\uB098 \uB2E8\uC5B4\uB97C \uB2E4 \uAC16\uB2E4 \uBD99\uC774\uB294
          \uD1B5\uC5D0 \uC804\uC138\uACC4\uB97C \uC544\uC6B0\uB974\uB294 \uC791\uBA85
          \uAC10\uAC01\uC774 \uB3CB\uBCF4\uC774\uB294 \uC774\uB984\uC774 \uD0C4\uC0DD\uD588\uC73C\uB2C8..."
    - rid: 7292419771869167695
      type: {class: Dialogue, ns: , asm: Assembly-CSharp}
      data:
        delayBefore: 0
        checkInput: 1
        textTargetPath: Shinuchi
        direction: 2
        Text: "\uC544\uC800\uC528!!! \uAE40\uC218\uD55C\uBB34\uAC00 \uBB3C\uC5D0
          \uBE60\uC84C\uC5B4\uC694!!"
    - rid: 7292419771869167696
      type: {class: Dialogue, ns: , asm: Assembly-CSharp}
      data:
        delayBefore: 0
        checkInput: 1
        textTargetPath: Shinuchi
        direction: 0
        Text: "\uB3C4\uB828\uB2D8 \uC774\uB984\uC744 \uD480\uB124\uC784\uC73C\uB85C
          \uBD80\uB974\uB77C\uACE0 \uB9C8\uB2D8\uC774 \uB9D0\uC500\uD558\uC2DC\uC9C0
          \uC54A\uC558\uB294\uAC00"
    - rid: 7292419771869167697
      type: {class: Dialogue, ns: , asm: Assembly-CSharp}
      data:
        delayBefore: 0
        checkInput: 1
        textTargetPath: Shinuchi
        direction: 0
        Text: "\uB9C8\uB2D8!! \uB3C4\uB828\uB2D8\uC774 \uBB3C\uC5D0 \uBE60\uC9C0\uC168\uB2F5\uB2C8\uB2E4!"
