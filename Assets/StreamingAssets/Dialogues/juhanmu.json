        "direction": "middle",
        "checkInput": true
      },
      {
        "type": "Dial",
        "delayBefore": 0.0,
        "text": "\"이름 부르는 거 듣다가,<delay=0.4f> 심심해서 그냥 나왔어.\"<delay=0.8f>",
        "direction": "right",
        "checkInput": true
      }
    ],

