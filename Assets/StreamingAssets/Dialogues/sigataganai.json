      "checkInput": true
    },
    {
      "type": "ChoiceDial",
      "delayBefore": 0.0,
      "direction": "left",
      "choices": [
        { "text": "(계속 죽은 척 버틴다)",          "branchId": "시가타가나이/4" },
        { "text": "(너무 무서워서 눈이 떠진다)",    "branchId": "시가타가나이/5" },
        { "text": "(배가 고파서 꼬르륵 소리가 난다)", "branchId": "시가타가나이/6" }
