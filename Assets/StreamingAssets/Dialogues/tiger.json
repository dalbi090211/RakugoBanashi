{
  "sceneName": "호랑이와 곶감",
  "dialogues": [
    {
      "type": "Dial",
      "delayBefore": 0.0,
      "text": "깊은 산속에 배고픈 호랑이 한 마리가 살았습니다.<delay=0.5f>",
      "direction": "middle",
      "checkInput": true
    },
    {
      "type": "Dial",
      "delayBefore": 0.0,
      "text": "어느 겨울 밤,<delay=0.3f> 호랑이는 마을로 내려왔습니다.<delay=0.4f>",
      "direction": "middle",
      "checkInput": true
    },
    {
      "type": "Dial",
      "delayBefore": 0.0,
      "text": "\"오늘은 소 한 마리 잡아먹어야겠다.\"<delay=0.6f>",
      "direction": "left",
      "checkInput": true
    },
    {
      "type": "Dial",
      "delayBefore": 0.0,
      "text": "외양간 앞에 웅크리고 앉아,<delay=0.3f> 때를 기다리고 있었지요.<delay=0.5f>",
      "direction": "middle",
      "checkInput": true
    },
    {
      "type": "Dial",
      "delayBefore": 0.0,
      "text": "그때,<delay=0.4f> 안방에서 아이 우는 소리가 들렸습니다.<delay=0.5f>",
      "direction": "middle",
      "checkInput": true
    },
    {
      "type": "Dial",
      "delayBefore": 0.0,
      "text": "어머니가 달래기 시작했습니다.<delay=0.3f>",
      "direction": "middle",
      "checkInput": true
    },
    {
      "type": "Dial",
      "delayBefore": 0.0,
      "text": "\"울지 마라,<delay=0.3f> 울지 마.<delay=0.3f> 저기 <speed=0.7f>늑대</speed> 온다!\"<delay=0.6f>",
      "direction": "right",
      "checkInput": true
    },
    {
      "type": "Dial",
      "delayBefore": 0.0,
      "text": "아이는 계속 울었습니다.<delay=0.5f>",
      "direction": "middle",
      "checkInput": true
    },
    {
      "type": "Dial",
      "delayBefore": 0.0,
      "text": "호랑이가 귀를 쫑긋 세웠습니다.<delay=0.4f>",
      "direction": "middle",
      "checkInput": true
    },
    {
      "type": "Dial",
      "delayBefore": 0.0,
      "text": "\"저 아이,<delay=0.3f> 늑대도 안 무서운가?\"<delay=0.6f>",
      "direction": "left",
      "checkInput": true
    },
    {
      "type": "Dial",
      "delayBefore": 0.0,
      "text": "어머니가 다시 말했습니다.<delay=0.3f>",
      "direction": "middle",
      "checkInput": true
    },
    {
      "type": "Dial",
      "delayBefore": 0.0,
      "text": "\"울지 마,<delay=0.3f> 뚝!<delay=0.2f> <speed=0.7f>호랑이</speed> 온다!\"<delay=0.6f>",
      "direction": "right",
      "checkInput": true
    },
    {
      "type": "Dial",
      "delayBefore": 0.0,
      "text": "아이는 여전히 울었습니다.<delay=0.5f>",
      "direction": "middle",
      "checkInput": true
    },
    {
      "type": "ChoiceDial",
      "delayBefore": 0.0,
      "direction": "left",
      "choices": [
        { "text": "(으쓱하며 뿌듯해한다)",       "branchId": "호랑이/1" },
        { "text": "(어딘가 불안한 기분이 든다)", "branchId": "호랑이/2" },
        { "text": "(그냥 소나 잡으러 간다)",     "branchId": "호랑이/3" }
      ]
    },
    {
      "type": "Dial",
      "delayBefore": 0.0,
      "text": "그때였습니다.<delay=0.8f>",
      "direction": "middle",
      "checkInput": true
    },
    {
      "type": "Dial",
      "delayBefore": 0.0,
      "text": "어머니가 목소리를 낮추며 말했습니다.<delay=0.4f>",
      "direction": "middle",
      "checkInput": true
    },
    {
      "type": "Dial",
      "delayBefore": 0.0,
      "text": "\"뚝.<delay=0.6f> <speed=0.6f>곶감</speed> 준다.\"<delay=1.0f>",
      "direction": "right",
      "checkInput": true
    },
    {
      "type": "Dial",
      "delayBefore": 0.0,
      "text": "<shake>아이가 울음을 뚝 그쳤습니다.</shake><delay=0.8f>",
      "direction": "middle",
      "checkInput": true
    },
    {
      "type": "Dial",
      "delayBefore": 0.0,
      "text": "호랑이는 등골이 오싹했습니다.<delay=0.6f>",
      "direction": "middle",
      "checkInput": true
    },
    {
      "type": "Dial",
      "delayBefore": 0.0,
      "text": "\"늑대도,<delay=0.3f> 나도 못 세웠는데...<delay=0.5f> <shake>곶감?!</shake>\"<delay=0.8f>",
      "direction": "left",
      "checkInput": true
    },
    {
      "type": "ChoiceDial",
      "delayBefore": 0.0,
      "direction": "left",
      "choices": [
        { "text": "(곶감이 뭔지 알아내야겠다)",   "branchId": "호랑이/4" },
        { "text": "(무조건 도망쳐야겠다)",         "branchId": "호랑이/5" },
        { "text": "(혹시 나보다 크지 않을까)",     "branchId": "호랑이/6" }
      ]
    },
    {
      "type": "EndingChoice",
      "delayBefore": 0.0,
      "endings": [
        { "title": "곶감의 정체를 밝힌다",     "branchId": "호랑이/ending1", "requiredFlow": 70 },
        { "title": "줄행랑을 친다",             "branchId": "호랑이/ending2", "requiredFlow": 40 },
        { "title": "소도둑과 엮인다",           "branchId": "호랑이/ending3", "requiredFlow": 20 },
        { "title": "곶감을 직접 먹어본다",      "branchId": "호랑이/ending4", "requiredFlow": 0  }
      ]
    }
  ],
